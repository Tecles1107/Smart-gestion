// ================= EXPORTACIÓN (EXCEL/PDF/WORD) =================
function descargarDocumento(td, tf) {
    if(inv.length===0) return alert("Sin datos.");
    let da = tf==='basico' ? inv.map(i=>({"CÓDIGO (UPC)":getSKU(i), "NOMBRE":getNom(i), "TOTAL PZAS":parseInt(i["Total"])||0})) : inv.map(i=>({"FECHA":i["Fecha_Captura"], "ÁREA":i["Área"]||arcActivo, "CÓDIGO (UPC)":getSKU(i), "NOMBRE":getNom(i), "BULTOS":parseInt(i["Bultos"])||0, "PZ/BTO":getPz(i), "TOTAL PZAS":parseInt(i["Total"])||0, "PRECIO UNIT":getPre(i), "TOTAL $":getPre(i)*(parseInt(i["Total"])||0), "CADUCIDAD":i["Caducidad"]||""}));
    let nDoc = `${arcActivo}_${tf.toUpperCase()}_${new Date().toISOString().slice(0,10)}`;
    if(td==='excel') { const ws=XLSX.utils.json_to_sheet(da); const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Inv"); XLSX.writeFile(wb, `${nDoc}.xlsx`); }
