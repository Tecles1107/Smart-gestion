        let sf=function(id, pvs){ let s=document.getElementById(id); s.innerHTML=""; importacionTemporal.columnas.forEach(c=>{ let o=document.createElement('option'); o.value=c; o.innerText=c; if(pvs.some(p=>c.toLowerCase().includes(p))) o.selected=true; s.appendChild(o); }); }; sf('selColCodigo',['codigo','sku','upc']); sf('selColNombre',['nombre','producto','descrip']); sf('selColBultos',['bulto','caja']); sf('selColPiezas',['pieza','total']); sf('selColPrecio',['precio','costo']); } catch(er) { alert("Error: "+er); }
