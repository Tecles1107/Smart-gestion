function uiArc() { let b=document.getElementById('badgeArchivoActivo'); if(b){ b.innerText=arcActivo.replace(/_/g," "); b.className=`badge text-truncate ${arcActivo==='Inventario_General'?'bg-success':'bg-primary'}`; } }
function uiDataList() { let dl=document.getElementById('sugerenciasNombres'); if(!dl) return; dl.innerHTML=""; let sts=new Set(); archIdx.forEach(ar=>{ let ls=sParse('inventario_'+ar,[]); ls.forEach(i=>{ let n=getNom(i); if(n!=="S/N"&&!sts.has(n.toLowerCase())){ sts.add(n.toLowerCase()); let o=document.createElement('option'); o.value=n; dl.appendChild(o); }}); }); }
