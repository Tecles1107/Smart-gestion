// ================= AUDIO WAV =================
function generarWavBeep(freq, durMs) {
    const sampleRate = 8000; const numSamples = Math.floor(sampleRate * (durMs / 1000)); const buffer = new Uint8Array(44 + numSamples);
    function writeStr(o, s) { for(let i=0; i<s.length; i++) buffer[o+i] = s.charCodeAt(i); }
    function writeU32(o, v) { buffer[o]=v&0xff; buffer[o+1]=(v>>8)&0xff; buffer[o+2]=(v>>16)&0xff; buffer[o+3]=(v>>24)&0xff; }
    function writeU16(o, v) { buffer[o]=v&0xff; buffer[o+1]=(v>>8)&0xff; }
    writeStr(0, 'RIFF'); writeU32(4, 36 + numSamples); writeStr(8, 'WAVE'); writeStr(12, 'fmt '); writeU32(16, 16); writeU16(20, 1); writeU16(22, 1); writeU32(24, sampleRate); writeU32(28, sampleRate); writeU16(32, 1); writeU16(34, 8); writeStr(36, 'data'); writeU32(40, numSamples);
    for(let i=0; i<numSamples; i++) { const t = i/sampleRate; buffer[44+i] = Math.floor(((Math.sin(2*Math.PI*freq*t) * (1-(i/numSamples))) * 0.5 + 0.5) * 255); }
    let bin = ''; for(let i=0; i<buffer.byteLength; i++) bin += String.fromCharCode(buffer[i]); return "data:audio/wav;base64," + btoa(bin);
}
const beepEx = new Audio(generarWavBeep(2400, 80)); const beepRe = new Audio(generarWavBeep(900, 140)); const beepIn = new Audio(generarWavBeep(1600, 100));
let audOK = false;
window.addEventListener('touchstart', ()=>{if(!audOK){beepEx.play().then(()=>{beepEx.pause();beepEx.currentTime=0;audOK=true;}).catch(()=>{});}}, {once:true});
function playBeep(t='ex') { try { let s=beepEx; if(t==='re')s=beepRe; if(t==='in')s=beepIn; s.currentTime=0; s.play().catch(()=>{}); }catch(e){} }
function hideKbd() { if(document.activeElement && document.activeElement.blur) document.activeElement.blur(); }

// ================= GLOBALES Y ESTADO =================
function sParse(k, fb) { try { let v = localStorage.getItem(k); return (!v || v==="undefined" || v==="null") ? fb : (JSON.parse(v) || fb); } catch(e) { return fb; } }
function cleanNum(c) { return c ? String(c).replace(/\D/g, "").trim() : ""; }
function getSKU(i) { return cleanNum(i["Código"] || i["SKU"] || i["UPC"]); }
function getNom(i) { return String(i["Nombre"] || i["Producto"] || "S/N").trim(); }
function getPz(i) { let p = parseInt(i["Piezas"])||0; if(p<=0 && i["Total"] && parseInt(i["Bultos"])>0) p = Math.round(i["Total"]/i["Bultos"]); return p>0?p:(parseInt(i["Total"])||1); }
function getPre(i) { return parseFloat(i["Precio"] || (i["_extraData"] ? i["_extraData"]["Precio"] : 0)) || 0; }
function getFch() { let f = new Date(); return `${String(f.getDate()).padStart(2,'0')}/${String(f.getMonth()+1).padStart(2,'0')} ${String(f.getHours()).padStart(2,'0')}:${String(f.getMinutes()).padStart(2,'0')}`; }

let arcActivo = localStorage.getItem('inventario_archivo_activo') || 'Inventario_General'; arcActivo = arcActivo.replace(/\s+/g, '_');
let archIdx = sParse('inventario_lista_archivos', ['Inventario_General']); if(!archIdx.includes('Inventario_General')) archIdx.unshift('Inventario_General'); if(!archIdx.includes(arcActivo)) archIdx.push(arcActivo); localStorage.setItem('inventario_lista_archivos', JSON.stringify(archIdx));
let inv = sParse('inventario_' + arcActivo, []);

let modo = 'entrada', qrCode = null, camOn = false, camPausa = false, pzCache = 1, prodAud = null, tempImp = { nom: "", rows: [], cols: [] };

window.addEventListener('DOMContentLoaded', () => {
    try { qrCode = new Html5Qrcode("reader"); } catch(e){}
    syncGenSilent(); uiArc(); uiDataList(); rendTab(); uiBtn(); hideKbd();
    fetch('/api/cargar_todo').then(r=>r.json()).then(d=>{ if(Object.keys(d.archivos||{}).length>0) { Object.keys(d.archivos).forEach(n=>{ let nl=n.replace(/\s+/g,'_'); localStorage.setItem('inventario_'+nl, JSON.stringify(d.archivos[n])); if(!archIdx.includes(nl)) archIdx.push(nl); }); localStorage.setItem('inventario_lista_archivos', JSON.stringify(archIdx)); } else { archIdx.forEach(n=>{ let it = sParse('inventario_'+n, []); if(it.length>0) saveToTermux(n, it); }); } }).catch(e=>{});
});

// ================= SINCRONIZACIÓN Y TERMUX =================
function saveToTermux(n, it) { fetch('/api/guardar_sesion', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ nombre: n.replace(/\s+/g, '_'), items: it }) }).catch(() => {}); }
function saveMem() { if(!archIdx.includes(arcActivo)) archIdx.push(arcActivo); localStorage.setItem('inventario_'+arcActivo, JSON.stringify(inv)); localStorage.setItem('inventario_archivo_activo', arcActivo); localStorage.setItem('inventario_lista_archivos', JSON.stringify(archIdx)); saveToTermux(arcActivo, inv); }
function guardarArchivoActualManual() { saveMem(); if(arcActivo !== 'Inventario_General') syncGenSilent(); hideKbd(); playBeep('ex'); alert(`💾 Guardado exitoso.`); }

function syncGenSilent() {
    let otras = archIdx.filter(a => a !== 'Inventario_General'); if(otras.length===0) return; let mapG = {};
    otras.forEach(nArea => {
        let items = sParse('inventario_' + nArea, []); if(!Array.isArray(items)) return; let etq = nArea.replace(/_/g, " ");
        items.forEach(it => {
            let sku = getSKU(it); if(!sku) return; let b = parseInt(it["Bultos"])||0, p = getPz(it), t = parseInt(it["Total"])||0, pr = getPre(it), cad = it["Caducidad"]||"", clv = cad ? `${sku}_${cad}` : sku;
            if(!mapG[clv]) mapG[clv] = { "Fecha_Captura": it["Fecha_Captura"]||getFch(), "Código": sku, "Nombre": getNom(it), "Caducidad": cad, "Bultos": 0, "Piezas": p, "Total": 0, "Precio": pr, "_am": {}, "_extraData": Object.assign({}, it["_extraData"]||{}) };
            if(mapG[clv]["Nombre"]==="S/N" && getNom(it)!=="S/N") mapG[clv]["Nombre"] = getNom(it); if(pr>0) mapG[clv]["Precio"] = pr;
            mapG[clv]._am[etq] = { b, p, t }; mapG[clv]["Bultos"]+=b; mapG[clv]["Total"]+=t;
        });
    });
    let listG = Object.values(mapG).map(pr => { let ar = Object.keys(pr._am); pr["Área"] = ar.join(", "); if(ar.length>1) { pr._extraData = pr._extraData||{}; pr._extraData["Desglose"] = ar.map(a => `${a}: ${pr._am[a].b}b (${pr._am[a].t}p)`).join(" | "); } delete pr._am; return pr; });
    localStorage.setItem('inventario_Inventario_General', JSON.stringify(listG)); saveToTermux('Inventario_General', listG);
    if(arcActivo === 'Inventario_General') inv = listG;
}

// ================= CÁMARA ANTI-FALLAS =================
function iniciarCamara() {
    hideKbd(); if(camOn) return; if(!qrCode) qrCode = new Html5Qrcode("reader");
    Html5Qrcode.getCameras().then(devs => {
        if(devs && devs.length>0) {
            qrCode.start(devs[devs.length-1].id, { fps: 15, qrbox: { width: 260, height: 120 } }, (txt) => { procCode(txt); }, (err) => {}).then(() => {
                camOn = true; camPausa = false; document.getElementById('btnIniciar').classList.add('d-none'); document.getElementById('btnDetener').classList.remove('d-none');
            }).catch(e => { alert("Error al conectar lente. "+e); });
        } else { alert("No se detectaron cámaras."); }
    }).catch(e => { alert("Permiso de cámara denegado. Dale permiso en Chrome."); });
}
function detenerCamara() {
    if(camOn && qrCode) { qrCode.stop().then(() => { camOn=false; camPausa=false; document.getElementById('btnIniciar').classList.remove('d-none'); document.getElementById('btnDetener').classList.add('d-none'); document.getElementById('alertaPausa').classList.add('d-none'); document.getElementById('reader').innerHTML=""; hideKbd(); }).catch(()=>{}); }
}
function procCode(txt) {
    if(!txt || camPausa) return; let sku = cleanNum(txt); if(sku.length < 3) return;
    try { qrCode.pause(true); camPausa=true; document.getElementById('alertaPausa').classList.remove('d-none'); } catch(e){}
    let inSKU = document.getElementById('sku'); inSKU.value = sku; inSKU.blur(); hideKbd();
    if(navigator.vibrate) navigator.vibrate([100,50,100]); inSKU.classList.add('bg-success', 'text-white'); setTimeout(()=>inSKU.classList.remove('bg-success', 'text-white'), 400);
    if(modo === 'consulta') return consultarProducto(sku);
    playBeep('ex'); autoRellenar(sku);
}
function descongelarCamara() {
    if(camOn && camPausa) { try { qrCode.resume(); camPausa=false; }catch(e){} }
    document.getElementById('alertaPausa').classList.add('d-none');
    document.getElementById('sku').value = ""; document.getElementById('nombre').value = ""; document.getElementById('bultos').value = "0"; document.getElementById('piezas').value = "0"; document.getElementById('total').value = "0"; pzCache = 1; hideKbd();
}

// ================= UI Y CAPTURA =================
function toggleOpciones() { document.getElementById('colCaducidad').style.display = document.getElementById('chkCaducidad').checked?'block':'none'; document.getElementById('colPrecio').style.display = document.getElementById('chkPrecio').checked?'block':'none'; }
function uiBtn() { let b=document.getElementById('btnGuardarRegistro'); if(modo==='consulta'){ b.className="btn btn-info w-100 py-2 fw-bold text-dark"; b.innerHTML="🔍 Auditoría"; } else if(modo==='salida'){ b.className="btn btn-danger w-100 py-2 fw-bold"; b.innerHTML="➖ Restar"; } else { b.className="btn btn-success w-100 py-2 fw-bold"; b.innerHTML="➕ Sumar"; } }
function cambiarModo(m) { modo = m; hideKbd(); uiBtn(); playBeep('in'); }
function calcTot() { let b=parseFloat(document.getElementById('bultos').value)||0, p=parseFloat(document.getElementById('piezas').value)||0; document.getElementById('total').value=(b===0)?p:(b*p); }
function alCambiarBultos() { let b=parseFloat(document.getElementById('bultos').value)||0, p=parseFloat(document.getElementById('piezas').value)||0; if(b>0 && p===0) document.getElementById('piezas').value = pzCache||1; calcTot(); }
function alCambiarPiezas() { calcTot(); }
function activarSoloPiezas() { document.getElementById('bultos').value="0"; calcTot(); let pi=document.getElementById('piezas'); if(pi) { pi.focus(); pi.select(); } }

function autoRellenar(sku) {
    let skuL = cleanNum(sku); if(!skuL) return; let enc = inv.find(i=>getSKU(i)===skuL);
    if(!enc) { for(let a of archIdx) { let its=sParse('inventario_'+a,[]); enc=its.find(i=>getSKU(i)===skuL); if(enc && getNom(enc)!=="S/N") break; } }
    if(enc && getNom(enc)!=="S/N") { document.getElementById('nombre').value=getNom(enc); pzCache=getPz(enc); if(document.getElementById('chkCaducidad').checked && enc["Caducidad"]) document.getElementById('caducidad').value=enc["Caducidad"]; if(document.getElementById('chkPrecio').checked && getPre(enc)>0) document.getElementById('precio').value=getPre(enc); } else { pzCache=1; }
    document.getElementById('bultos').value="0"; document.getElementById('piezas').value="0"; document.getElementById('total').value="0";
}
function alEscribirSKU() { let ip = document.getElementById('sku'); let l = cleanNum(ip.value); if(ip.value!==l) ip.value=l; if(modo==='consulta') return consultarProducto(l); autoRellenar(l); }
function alEscribirNombre() { let s = cleanNum(document.getElementById('sku')?.value); if(s) return; let n = (document.getElementById('nombre')?.value||"").trim().toLowerCase(); if(!n) return; let enc=inv.find(i=>getNom(i).toLowerCase()===n); if(!enc){ for(let a of archIdx){ let its=sParse('inventario_'+a,[]); enc=its.find(i=>getNom(i).toLowerCase()===n); if(enc) break; } } if(enc){ document.getElementById('sku').value=getSKU(enc); pzCache=getPz(enc); document.getElementById('bultos').value="0"; document.getElementById('piezas').value="0"; document.getElementById('total').value="0"; } }

function agregarRegistro() {
    let sku = cleanNum(document.getElementById('sku').value), nom = document.getElementById('nombre').value.trim()||"S/N", b = parseInt(document.getElementById('bultos').value)||0, p = parseInt(document.getElementById('piezas').value)||0, t = parseInt(document.getElementById('total').value)||0;
    let cad = document.getElementById('chkCaducidad').checked ? document.getElementById('caducidad').value : ""; let pre = document.getElementById('chkPrecio').checked ? parseFloat(document.getElementById('precio').value)||0 : 0;
    if(!sku) return; if(modo==='consulta') return consultarProducto(sku); if(t<=0 && b<=0 && p<=0) return alert("Cantidad inválida.");
    let idx = inv.findIndex(i => getSKU(i)===sku && (i["Caducidad"]||"")===cad);
    if(modo==='salida') {
        if(idx===-1) { playBeep('re'); return alert("No existe el código para restar."); }
        inv[idx]["Bultos"]=Math.max(0, (parseInt(inv[idx]["Bultos"])||0)-b); inv[idx]["Total"]=Math.max(0, (parseInt(inv[idx]["Total"])||0)-t); inv[idx]["Fecha_Captura"]=getFch()+" (-)"; playBeep('re');
    } else {
        if(idx!==-1) { inv[idx]["Bultos"]=(parseInt(inv[idx]["Bultos"])||0)+b; inv[idx]["Total"]=(parseInt(inv[idx]["Total"])||0)+t; if(pre>0) inv[idx]["Precio"]=pre; inv[idx]["Fecha_Captura"]=getFch(); }
        else { inv.unshift({"Fecha_Captura":getFch(), "Área":arcActivo.replace(/_/g," "), "Código":sku, "Nombre":nom, "Caducidad":cad, "Bultos":b, "Piezas":p||t||1, "Total":t, "Precio":pre, "_extraData":{}}); } playBeep('ex');
    }
    saveMem(); if(arcActivo!=='Inventario_General') syncGenSilent(); uiDataList(); rendTab(); document.getElementById('formInventario').reset(); document.getElementById('bultos').value="0"; document.getElementById('piezas').value="0"; document.getElementById('total').value="0"; if(document.getElementById('chkCaducidad').checked) document.getElementById('caducidad').value=""; if(document.getElementById('chkPrecio').checked) document.getElementById('precio').value=""; pzCache=1; descongelarCamara(); hideKbd();
}

// ================= TABLA Y BOTONES +/- =================
function rendTab() {
    let tb=document.getElementById('tablaBody'); if(!tb) return; let fl=document.getElementById('inputBuscarTabla')?.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").trim();
    let res = inv.map((it, x)=>({it, x})); if(fl) { let pw = fl.split(' ').filter(p=>p.length>0); res = res.filter(({it})=>{ let txt = Object.values(it).map(v=>(typeof v==='object'?Object.values(v).join(' '):String(v||""))).join(" ").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,""); return pw.every(p=>txt.includes(p)); }); }
    let tbultos=0, tpzs=0; inv.forEach(i=>{ tbultos+=parseInt(i["Bultos"])||0; tpzs+=parseInt(i["Total"])||0; }); document.getElementById('resumenTotales').innerText = `Bultos: ${tbultos} | Pzs: ${tpzs}`; document.getElementById('contadorRegistros').innerText = fl?`${res.length}/${inv.length}`:inv.length;
    if(res.length===0){ tb.innerHTML=`<tr><td colspan="8" class="text-muted py-4">Tabla vacía.</td></tr>`; return; } tb.innerHTML="";
    res.forEach(({it, x}) => {
        let pzn = getPz(it), b = parseInt(it["Bultos"])||0, dif = (parseInt(it["Total"])||0)-(b*pzn); let dh = dif<0?`<small class="text-danger">(${dif})</small>`:dif>0?`<small class="text-success">(+${dif})</small>`:"";
        let xt = (it["Caducidad"]?`<br><span class="badge bg-danger">⏳${it["Caducidad"]}</span>`:"")+(getPre(it)>0?`<span class="badge bg-success ms-1">$${getPre(it)}</span>`:"");
        let tr=document.createElement('tr'); tr.innerHTML=`<td class="small">${it["Fecha_Captura"]}</td><td><span class="badge bg-primary">${it["Área"]||arcActivo}</span></td><td class="text-primary fw-bold">${getSKU(it)}</td><td class="fw-bold">${getNom(it)}${xt}</td><td><div class="d-flex gap-1 justify-content-center"><button class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold" onclick="chgB(${x},-1)">-</button><span class="badge bg-secondary fs-6">${b}</span><button class="btn btn-sm btn-outline-success py-0 px-2 fw-bold" onclick="chgB(${x},1)">+</button></div></td><td><div class="d-flex gap-1 justify-content-center"><button class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold" onclick="chgP(${x},-1)">-</button><span class="badge bg-light text-dark border fs-6">${pzn}${dh}</span><button class="btn btn-sm btn-outline-success py-0 px-2 fw-bold" onclick="chgP(${x},1)">+</button></div></td><td class="fw-bold text-danger fs-5">${it["Total"]}</td><td><button class="btn btn-sm btn-outline-primary py-0 px-1 me-1" onclick="abrirModalEditar(${x})"><i class="fa-solid fa-pencil"></i></button><button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="if(confirm('Borrar?')){inv.splice(${x},1);saveMem();rendTab();}"><i class="fa-solid fa-trash"></i></button></td>`; tb.appendChild(tr);
    });
}
function chgB(x,d) { hideKbd(); let it=inv[x], nb=(parseInt(it["Bultos"])||0)+d; if(nb<=0){ if(confirm("¿Eliminar?")) inv.splice(x,1); else { it["Bultos"]=0; it["Total"]=0; } } else { it["Bultos"]=nb; it["Total"]=Math.max(0, (parseInt(it["Total"])||0)+(d*getPz(it))); it["Fecha_Captura"]=getFch(); } playBeep('ex'); saveMem(); rendTab(); }
function chgP(x,d) { hideKbd(); let it=inv[x], nt=(parseInt(it["Total"])||0)+d; if(nt<=0){ if(confirm("¿Eliminar?")) inv.splice(x,1); else { it["Bultos"]=0; it["Total"]=0; } } else { it["Total"]=nt; if((parseInt(it["Bultos"])||0)<=1){ it["Bultos"]=1; it["Piezas"]=nt; } it["Fecha_Captura"]=getFch(); } playBeep('ex'); saveMem(); rendTab(); }
function filtrarTabla() { rendTab(); } function limpiarBuscador() { document.getElementById('inputBuscarTabla').value=""; rendTab(); hideKbd(); }
function abrirModalEditar(x) { let it=inv[x]; document.getElementById('editIndex').value=x; document.getElementById('editSKU').value=getSKU(it); document.getElementById('editNombre').value=getNom(it); document.getElementById('editBultos').value=it["Bultos"]||0; document.getElementById('editPiezas').value=getPz(it); document.getElementById('editCaducidad').value=it["Caducidad"]||""; document.getElementById('editPrecio').value=getPre(it); new bootstrap.Modal(document.getElementById('modalEditarFila')).show(); }
function guardarEdicionFila() { let x=document.getElementById('editIndex').value, it=inv[x]; it["Nombre"]=document.getElementById('editNombre').value||"S/N"; it["Bultos"]=parseInt(document.getElementById('editBultos').value)||0; it["Piezas"]=parseInt(document.getElementById('editPiezas').value)||0; it["Total"]=it["Bultos"]*it["Piezas"]; it["Caducidad"]=document.getElementById('editCaducidad').value; it["Precio"]=parseFloat(document.getElementById('editPrecio').value)||0; it["Fecha_Captura"]=getFch()+" (Ed)"; playBeep('ex'); saveMem(); rendTab(); bootstrap.Modal.getInstance(document.getElementById('modalEditarFila')).hide(); }

// ================= AUDITORÍA GLOBAL =================
function consultarProducto(sku) {
    let cl=cleanNum(sku); if(!cl) return; let res = { sku:cl, nom:"S/N", pz:1, aps:[], bTot:0, pTot:0, enEsta:null };
    archIdx.forEach(ar=>{ let ls=sParse('inventario_'+ar,[]); ls.filter(i=>getSKU(i)===cl).forEach(en=>{ if(res.nom==="S/N"&&getNom(en)!=="S/N") res.nom=getNom(en); res.pz=getPz(en); let b=parseInt(en["Bultos"])||0, t=parseInt(en["Total"])||0; if(ar!=='Inventario_General'){ res.bTot+=b; res.pTot+=t; } res.aps.push({ ar:ar.replace(/_/g," "), b, p:getPz(en), t, f:en["Fecha_Captura"]||"", c:en["Caducidad"]||""}); if(ar===arcActivo) res.enEsta=en; }); });
    if(res.aps.length===0) { playBeep('re'); alert("No existe."); return; }
    prodAud = res; playBeep('in'); document.getElementById('resConsultaNombre').innerText=res.nom; document.getElementById('resConsultaSKU').innerText="SKU: "+res.sku; document.getElementById('resConsultaStockGlobal').innerText=`${res.bTot} b | ${res.pTot} pzs`; document.getElementById('resConsultaStockActual').innerText = res.enEsta ? `${res.enEsta["Bultos"]} b | ${res.enEsta["Total"]} pzs` : "0 (No en lista)";
    let ul = document.getElementById('resConsultaListaArchivos'); ul.innerHTML=""; res.aps.forEach(a=>{ let li=document.createElement('li'); li.className="list-group-item d-flex justify-content-between py-1"; li.innerHTML=`<div><strong>${a.ar}</strong> <span class="text-danger small">${a.c?'⏳'+a.c:''}</span><br><span class="text-muted">${a.b} b (Tot: ${a.t})</span></div><span class="badge bg-secondary">${a.f}</span>`; ul.appendChild(li); });
    new bootstrap.Modal(document.getElementById('modalAuditoria')).show();
}
function traerProductoACaptura() { if(!prodAud) return; document.getElementById('sku').value=prodAud.sku; document.getElementById('nombre').value=prodAud.nom; pzCache=prodAud.pz||1; document.getElementById('bultos').value="0"; document.getElementById('piezas').value="0"; document.getElementById('total').value="0"; document.getElementById('modoEntrada').checked=true; cambiarModo('entrada'); bootstrap.Modal.getInstance(document.getElementById('modalAuditoria')).hide(); }

