function cerrarGestorArchivos() { document.getElementById('panelGestorArchivos').style.display='none'; }
function cambiarDeArchivoPorIndice(x) { saveMem(); arcActivo=archIdx[x]; if(arcActivo==='Inventario_General') syncGenSilent(); inv=sParse('inventario_'+arcActivo,[]); uiArc(); uiDataList(); rendTab(); cerrarGestorArchivos(); }
function crearSesionAreaRapida(n) { saveMem(); arcActivo=n.trim().replace(/\s+/g,'_'); inv=sParse('inventario_'+arcActivo,[]); saveMem(); uiArc(); uiDataList(); rendTab(); cerrarGestorArchivos(); }
