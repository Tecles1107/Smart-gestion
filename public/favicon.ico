<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="gradBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b1120"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <linearGradient id="laserGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ef4444" stop-opacity="0"/>
      <stop offset="50%" stop-color="#ef4444"/>
      <stop offset="100%" stop-color="#ef4444" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="512" height="512" rx="100" fill="url(#gradBg)"/>
  <rect width="500" height="500" x="6" y="6" rx="94" fill="none" stroke="#1e293b" stroke-width="8"/>

  <!-- Industrial Target Box -->
  <path d="M 120 170 L 120 120 L 170 120" fill="none" stroke="#3b82f6" stroke-width="18" stroke-linecap="round"/>
  <path d="M 392 170 L 392 120 L 342 120" fill="none" stroke="#3b82f6" stroke-width="18" stroke-linecap="round"/>
  <path d="M 120 342 L 120 392 L 170 392" fill="none" stroke="#3b82f6" stroke-width="18" stroke-linecap="round"/>
  <path d="M 392 342 L 392 392 L 342 392" fill="none" stroke="#3b82f6" stroke-width="18" stroke-linecap="round"/>

  <!-- Barcode Bars -->
  <rect x="156" y="180" width="16" height="152" rx="6" fill="#f8fafc"/>
  <rect x="188" y="180" width="8" height="152" rx="4" fill="#f8fafc"/>
  <rect x="212" y="180" width="24" height="152" rx="6" fill="#f8fafc"/>
  <rect x="252" y="180" width="12" height="152" rx="4" fill="#f8fafc"/>
  <rect x="280" y="180" width="28" height="152" rx="6" fill="#f8fafc"/>
  <rect x="324" y="180" width="12" height="152" rx="4" fill="#f8fafc"/>
  <rect x="348" y="180" width="16" height="152" rx="6" fill="#f8fafc"/>

  <!-- Laser Beam Line -->
  <line x1="100" y1="256" x2="412" y2="256" stroke="url(#laserGrad)" stroke-width="12" stroke-linecap="round"/>
  <line x1="120" y1="256" x2="392" y2="256" stroke="#ffffff" stroke-width="4" stroke-linecap="round"/>

  <!-- PRO Badge -->
  <rect x="320" y="380" width="110" height="42" rx="10" fill="#10b981"/>
  <text x="375" y="410" font-family="Arial, sans-serif" font-size="24" font-weight="900" fill="#ffffff" text-anchor="middle">PRO</text>
</svg>
